#!/usr/bin/bash

# BLAST the final ASVs (fasta_tab.fa from 1.DADA2_direct.R or 1.DADA2_culture.R) against the NCBI 16S ribosomal RNA database.
# Keeps up to 10 hits per ASV with >= 95% identity and alignment length >= 10 bp.
# The 99% identity and 90% query coverage filters and the choice of the best hit are done in filter_blast.R.

set -euo pipefail

: "${BLASTDB:?Set BLASTDB to the folder containing the 16S_ribosomal_RNA BLAST database}"
export BLASTDB

FASTA="fasta_tab.fa"
OUTDIR="2.blast"
DB="16S_ribosomal_RNA"

mkdir -p $OUTDIR

blastn -version

blastn -query $FASTA \
	-db $DB \
	-outfmt '6 qseqid sseqid pident length evalue score qlen qcovs stitle' \
	-num_alignments 10 | awk 'BEGIN{FS=OFS="\t"; print "seqid\tsseqid\tpident\tlength\tevalue\tscore\tqlen\tqcovs\tstitle"}$3 >= 95 && $4 >= 10' | cut -d' ' -f1,2 | column -t  > ${OUTDIR}/tax_tab_95_10align_16S
